# Nextware backend — development environment template.
# Copy to backend/.env and fill in real values. Never commit backend/.env.
#
# These variables feed application.properties via ${...} placeholders.
# Load them into your shell before running the backend, e.g.:
#   set -a && . ./backend/.env && set +a
# or point your IDE run configuration at this env file.

# Active Spring profile. Use "dev" to enable the development data seeder.
SPRING_PROFILES_ACTIVE=dev

# --- JWT -------------------------------------------------------------------
# HMAC signing secret for issued tokens (>= 32 bytes). Generate one with:
#   openssl rand -base64 48
NEXTWARE_JWT_SECRET=change-me-to-a-long-random-secret
# Optional: token lifetime in minutes (default 480).
NEXTWARE_JWT_EXPIRATION_MINUTES=480

# --- Development data seeder (dev profile only) --------------------------
# Creates the standard role/permission matrix plus one user per role for the
# demo company (id 10000000-0000-0000-0000-000000000001) and the isolation
# test company (id 20000000-0000-0000-0000-000000000002). Idempotent.
NEXTWARE_SECURITY_BOOTSTRAP_ENABLED=true
# Username/email of the primary admin user (defaults shown).
NEXTWARE_BOOTSTRAP_USERNAME=admin
NEXTWARE_BOOTSTRAP_EMAIL=admin@nextware.local
# Development-only password shared by every seeded user. Never a real secret.
NEXTWARE_BOOTSTRAP_PASSWORD=

# Seed realistic demo master data (units, categories, products, customers,
# suppliers, warehouses, locations). Safe to leave enabled in dev.
NEXTWARE_DEMO_DATA_ENABLED=true
