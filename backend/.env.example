# Nextware backend — development environment template.
# Copy to backend/.env and fill in real values. Never commit backend/.env.
#
# These variables are consumed by application.properties via ${...} placeholders.
# Load them into your shell before running the backend, e.g.:
#   set -a && . ./backend/.env && set +a
# or configure your IDE run configuration to use this env file.

# Active Spring profile. Use "dev" to enable the development security bootstrap.
SPRING_PROFILES_ACTIVE=dev

# --- JWT ---------------------------------------------------------------------
# HMAC signing secret for issued tokens. Use a long random value (>= 32 bytes).
# Generate one with:  openssl rand -base64 48
NEXTWARE_JWT_SECRET=change-me-to-a-long-random-secret
# Optional: token lifetime in minutes (default 480).
NEXTWARE_JWT_EXPIRATION_MINUTES=480

# --- Development security bootstrap ----------------------------------------
# Only runs when SPRING_PROFILES_ACTIVE=dev AND this flag is true.
# Creates/updates an admin Role + User for an EXISTING company. Idempotent.
NEXTWARE_SECURITY_BOOTSTRAP_ENABLED=true
# UUID of an existing, active company row (seeded by Flyway V10 in dev).
NEXTWARE_SECURITY_BOOTSTRAP_COMPANY_ID=
NEXTWARE_SECURITY_BOOTSTRAP_USERNAME=admin
NEXTWARE_SECURITY_BOOTSTRAP_EMAIL=admin@nextware.local
# Development-only password for the bootstrap admin user. Never a real credential.
NEXTWARE_SECURITY_BOOTSTRAP_PASSWORD=
